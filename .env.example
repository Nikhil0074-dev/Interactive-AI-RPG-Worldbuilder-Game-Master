# Copy to .env and edit. NEVER commit real keys. All values are optional: without them the game runs fully offline
# with the built-in deterministic Game Master and procedural placeholder artwork.

# --- Database (SQLite by default; PostgreSQL: postgresql+psycopg://user:pass@host/db after `pip install psycopg[binary]`)
DATABASE_URL=sqlite:///./data/rpg.db
ASSET_DIR=./data/assets

# --- Narrative LLM (any OpenAI-compatible /chat/completions endpoint). Leave LLM_API_KEY empty for the offline mock.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Artwork: "placeholder" (procedural SVG, default) or "huggingface" (FLUX via the HF inference router)
IMAGE_PROVIDER=placeholder
HF_TOKEN=
FLUX_MODEL=black-forest-labs/FLUX.1-schnell

# --- Safety / cost controls
MAX_INPUT_CHARS=300
RATE_ACTION_PER_MIN=120
RATE_GENERATE_PER_MIN=20
RATE_ASSET_PER_MIN=30
MAX_CAMPAIGNS_PER_USER=25
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend -> backend proxy target (frontend/.env.local or compose)
BACKEND_URL=http://127.0.0.1:8000
